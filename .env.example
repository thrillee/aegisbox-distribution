# =============================================================================
# Aegisbox Distribution - Environment Configuration
# =============================================================================
# Copy this file to .env and update values before deployment

# =============================================================================
# Database Configuration (Managed/External PostgreSQL)
# =============================================================================
# Use an external managed PostgreSQL database (AWS RDS, Supabase, Neon, etc.)
# Example: postgres://user:password@host:5432/database?sslmode=require

DATABASE_URL=postgres://aegisbox:your_password@your-managed-db-host:5432/aegisbox_prod?sslmode=require

# =============================================================================
# Image Tag (override with CI/CD pipeline)
# =============================================================================
TAG=docker-prod

# =============================================================================
# Manager API Configuration
# =============================================================================
API_ADDR=:8001
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=10s
# Public URL of the manager API, used in webhook callback URLs given to HTTP MNOs
API_BASE_URL=https://api.example.com
# REQUIRED in production: without it anyone who can reach the manager API can
# credit wallets and send DLRs. Generate with: openssl rand -hex 32
# The portal sends it automatically (same .env).
MANAGER_API_KEY=change_me_long_random_string

# =============================================================================
# Gateway listen addresses (inside the container; match the port mappings)
# =============================================================================
SERVER_HOST=0.0.0.0:6886
HTTP_CONFIG_ADDR=0.0.0.0:8000
API_DLR_ADDR=9001
# Optional: when set, DLR callbacks on port 9001 must carry this key (X-API-KEY header,
# Bearer token or ?key=...). Add it to every upstream's DLR URL before setting it.
API_DLR_KEY=

# =============================================================================
# SMPP Gateway Configuration
# =============================================================================
SMPP_SYSTEM_ID=your_smpp_system_id
SMPP_PASSWORD=your_smpp_password
SMPP_SYSTEM_TYPE=
SMPP_ADDR_TON=1
SMPP_ADDR_NPI=1
SMPP_BIND_MODE=2
SMPP_RECONNECT_DELAY=5s
SMPP_ENQUIRE_LINK_INTERVAL=30s
SMPP_RESPONSE_TIMEOUT=10s

# =============================================================================
# Portal Configuration
# =============================================================================
# Internal address the portal uses to reach the manager API
MANAGER_API_URL=http://manager-api:8001
CLERK_SECRET_KEY=sk_live_xxx
# Address customers bind to, shown with each SMPP login in the portal
SMPP_PUBLIC_HOST=smpp.example.com
SMPP_PUBLIC_PORT=6886
# Base URL of the HTTP API (port 8000), shown on the customer Connection page
HTTP_API_PUBLIC_URL=https://sms-api.example.com
CLERK_ADMIN_ORG_ID=org_xxx
# NEXT_PUBLIC_* values are built into the portal's browser code: rebuild after changing them
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
NEXT_PUBLIC_CLERK_ADMIN_ORG_ID=org_xxx
NEXT_PUBLIC_APP_URL=https://portal.example.com

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# Service Ports (change if ports are in use)
# =============================================================================
API_PORT=8001
SMPP_PORT=2775
PORTAL_PORT=3001
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100

# =============================================================================
# Grafana Configuration
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=secure_password_change_this
GF_USERS_ALLOW_SIGN_UP=false

# =============================================================================
# Simulated MNO (test traffic only; internal service "mnosim", port 2776)
# =============================================================================
MNOSIM_SYSTEM_ID=simulator
MNOSIM_PASSWORD=change_me
# Receipt delay range and outcome mix (STATUS:WEIGHT; NONE = no DLR)
MNOSIM_DLR_DELAY_MIN=2s
MNOSIM_DLR_DELAY_MAX=10s
MNOSIM_DLR_MIX=DELIVRD:90,UNDELIV:5,EXPIRED:2,NONE:3
# Share of submits rejected (status 0x58) or left unanswered, 0 to 100
MNOSIM_REJECT_PERCENT=0
MNOSIM_NO_RESPONSE_PERCENT=0

# =============================================================================
# Link scanning (simulator messages; real customers only when their Link Check
# mode in the portal is not Off, which is the default)
# =============================================================================
# Find links in simulator messages and queue them for the link scanner
LINKSCAN_EXTRACT_ENABLED=true
# Skip messages that read like one time passwords
LINKSCAN_SKIP_OTP=true
# Links of one campaign (same customer, host and path apart from a per recipient
# token) opened per hour; the rest share the verdict of the ones opened
LINKSCAN_SAMPLE_PER_HOUR=3

# Open queued links in the linkscanner service. Needs LINKSCAN_TOKEN.
# Full guide: docs/LINK_SCANNING_ENABLE.md
LINKSCAN_ENABLED=false
# Shared secret between aegisbox and linkscanner (at least 16 characters).
# Generate with: openssl rand -hex 32. Without it the linkscanner stays idle.
LINKSCAN_TOKEN=
# REQUIRED for scanning: the server's public IP (comma separated, CIDR allowed), so
# a scanned page can never reach the server itself. The scanner stays idle without it. On the server: curl -4 ifconfig.me
# Private ranges, cloud metadata and the database host are always blocked.
LINKSCAN_BLOCK_IPS=
# Extra host names a scanned page may not reach
LINKSCAN_BLOCK_HOSTS=
# Exit proxies so scans do not all come from the server's own IP, comma separated,
# e.g. http://user:pass_country-ng_session-{session}@geo.iproyal.com:12321
# {session} is replaced per scan with a unique id, so the provider holds one IP for
# the whole page load. Empty: scans use the server's address. If set but none is
# reachable, scans fail rather than fall back to the server's address.
LINKSCAN_PROXY_POOL=
# Pages open at the same time (use the same value for both services)
LINKSCAN_MAX_CONCURRENCY=2
# Limits for the linkscanner container (Chromium needs about 1 to 2 GB)
LINKSCAN_MEMORY=2g
LINKSCAN_CPUS=1.5
# Time per page in milliseconds
LINKSCAN_TIMEOUT_MS=20000
# Retention: screenshots 7 days, results and jobs 4 weeks
LINKSCAN_SCREENSHOT_RETENTION=168h
LINKSCAN_RESULT_RETENTION=672h
# Log a warning when this many links are waiting
LINKSCAN_BACKLOG_WARN=500
# Look up how old a link's domain is (RDAP; aegisbox needs outbound HTTPS)
LINKSCAN_RDAP_ENABLED=true
# abuse.ch URLhaus key (list of malware links). Leave empty until abuse.ch's terms
# for commercial use are accepted. Key from https://auth.abuse.ch/
LINKSCAN_URLHAUS_AUTH_KEY=
