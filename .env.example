# =============================================================================
# Aegisbox Distribution - Environment Configuration
# =============================================================================
# Copy this file to .env and update values before deployment

# =============================================================================
# Database Configuration (Managed/External PostgreSQL)
# =============================================================================
# Use an external managed PostgreSQL database (AWS RDS, Supabase, Neon, etc.)
# Example: postgres://user:password@host:5432/database?sslmode=require

DATABASE_URL=postgres://aegisbox:your_password@your-managed-db-host:5432/aegisbox_prod?sslmode=require

# =============================================================================
# Image Tag (override with CI/CD pipeline)
# =============================================================================
TAG=docker-prod

# =============================================================================
# Manager API Configuration
# =============================================================================
API_ADDR=:8001
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=10s
# Public URL of the manager API, used in webhook callback URLs given to HTTP MNOs
API_BASE_URL=https://api.example.com
# REQUIRED in production: without it anyone who can reach the manager API can
# credit wallets and send DLRs. Generate with: openssl rand -hex 32
# The portal sends it automatically (same .env).
MANAGER_API_KEY=change_me_long_random_string

# =============================================================================
# Gateway listen addresses (inside the container; match the port mappings)
# =============================================================================
SERVER_HOST=0.0.0.0:6886
HTTP_CONFIG_ADDR=0.0.0.0:8000
API_DLR_ADDR=9001

# =============================================================================
# SMPP Gateway Configuration
# =============================================================================
SMPP_SYSTEM_ID=your_smpp_system_id
SMPP_PASSWORD=your_smpp_password
SMPP_SYSTEM_TYPE=
SMPP_ADDR_TON=1
SMPP_ADDR_NPI=1
SMPP_BIND_MODE=2
SMPP_RECONNECT_DELAY=5s
SMPP_ENQUIRE_LINK_INTERVAL=30s
SMPP_RESPONSE_TIMEOUT=10s

# =============================================================================
# Portal Configuration
# =============================================================================
# Internal address the portal uses to reach the manager API
MANAGER_API_URL=http://manager-api:8001
CLERK_SECRET_KEY=sk_live_xxx
CLERK_ADMIN_ORG_ID=org_xxx
# NEXT_PUBLIC_* values are built into the portal's browser code: rebuild after changing them
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
NEXT_PUBLIC_CLERK_ADMIN_ORG_ID=org_xxx
NEXT_PUBLIC_APP_URL=https://portal.example.com

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# Service Ports (change if ports are in use)
# =============================================================================
API_PORT=8001
SMPP_PORT=2775
PORTAL_PORT=3001
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100

# =============================================================================
# Grafana Configuration
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=secure_password_change_this
GF_USERS_ALLOW_SIGN_UP=false
