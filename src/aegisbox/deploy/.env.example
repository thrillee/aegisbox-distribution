# Database
DATABASE_URL=postgres://aegisbox:aegisbox@postgres:5432/aegisbox_dev?sslmode=disable

# Manager API
API_ADDR=:8001
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=10s

# SMPP Gateway
SMPP_SYSTEM_ID=your_system_id
SMPP_PASSWORD=your_password
SMPP_SYSTEM_TYPE=
SMPP_ADDR_TON=1
SMPP_ADDR_NPI=1
SMPP_BIND_MODE=2
SMPP_RECONNECT_DELAY=5s
SMPP_ENQUIRE_LINK_INTERVAL=30s
SMPP_RESPONSE_TIMEOUT=10s

# Logging
LOG_LEVEL=info

# Grafana (optional overrides)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Simulated MNO (test traffic only). MNOSIM_ENABLED=true makes "aegisbox all" run it in the same
# process; it then listens on 127.0.0.1:2776 unless MNOSIM_ADDR is set. On every start it also
# records itself in the database: an MNO named "mnosim" marked as simulator, with its SMPP connection.
# MNOSIM_ROUTING_GROUPS lists routing group references that should send to it; each gets simulator
# routes, and its test customers get a simulator price of MNOSIM_PRICE if they have none.
# MNOSIM_ENABLED=false
# MNOSIM_SYSTEM_ID=simulator
# MNOSIM_PASSWORD=change_me   # up to 8 characters
# MNOSIM_ROUTING_GROUPS=      # e.g. THRILLEE_TEST
# MNOSIM_PRICE=0.01
